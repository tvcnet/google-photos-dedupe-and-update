{
  "manifest_version": 3,
  "name": "Google Photos Toolkit (GPTK)",
  "version": "4.5.0",
  "description": "Toolkit for Google Photos: scan duplicates and generate photo descriptions with Gemini or local Ollama.",
  "author": "Jim Walker, @TVCNet",
  "homepage_url": "https://github.com/tvcnet/gptk",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icon16.plasmo.6c567d50.png",
    "32": "icon32.plasmo.76b92899.png",
    "48": "icon48.plasmo.aced7582.png",
    "64": "icon64.plasmo.8bb5e6e0.png",
    "128": "icon128.plasmo.3c1ed2d2.png"
  },
  "action": {
    "default_title": "Google Photos Toolkit",
    "default_icon": {
      "16": "icon16.plasmo.6c567d50.png",
      "32": "icon32.plasmo.76b92899.png",
      "48": "icon48.plasmo.aced7582.png",
      "64": "icon64.plasmo.8bb5e6e0.png",
      "128": "icon128.plasmo.3c1ed2d2.png"
    }
  },
  "background": {
    "service_worker": "static/background/index.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://photos.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["google-photos-bridge.8ad19c6d.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["google-photos-image-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["google-photos-inject.757a6863.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/unsafewindow-shim.js",
        "scripts/google-photos-toolkit.user.js",
        "scripts/google-photos-commands.js",
        "scripts/vision_wasm_internal.js",
        "scripts/vision_wasm_internal.wasm",
        "scripts/embedder-worker.js"
      ],
      "matches": ["https://photos.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
